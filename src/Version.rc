#include <winres.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION TRACK_QUEST_VERSION_MAJOR, TRACK_QUEST_VERSION_MINOR, TRACK_QUEST_VERSION_PATCH, 0
PRODUCTVERSION TRACK_QUEST_VERSION_MAJOR, TRACK_QUEST_VERSION_MINOR, TRACK_QUEST_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS VS_FF_DEBUG
#else
FILEFLAGS 0
#endif
FILEOS VOS__WINDOWS32
FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileVersion", TRACK_QUEST_FILE_VERSION
            VALUE "InternalName", TRACK_QUEST_NAME
            VALUE "LegalCopyright", TRACK_QUEST_AUTHOR
            VALUE "LegalTrademarks", TRACK_QUEST_LICENSE
            VALUE "ProductName", TRACK_QUEST_NAME
            VALUE "ProductVersion", TRACK_QUEST_FILE_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
